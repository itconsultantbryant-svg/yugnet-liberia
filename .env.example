# --- Local development (PostgreSQL) ---
DATABASE_URL="postgresql://USER@localhost:5432/yugnet?schema=public"
# Docker Compose alternative:
# DATABASE_URL="postgresql://yugnet:yugnet@localhost:5432/yugnet?schema=public"

AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Production: Vercel (frontend) ---
# NEXT_PUBLIC_SITE_URL="https://www.your-domain.lr"
# API_BACKEND_URL="https://yugnet-api.onrender.com"
# Must match Render AUTH_SECRET so portal JWT middleware verifies sessions
# AUTH_SECRET="<same-as-render>"
# DATABASE_URL="<same-postgres-as-render>"   # needed for Server Components / RSC
# COOKIE_SAMESITE="lax"
# COOKIE_SECURE="true"

# --- Production: Render (backend) ---
# DATABASE_URL is injected from Render Postgres
# AUTH_SECRET generated or set manually (share with Vercel)
# CORS_ORIGINS="https://www.your-domain.lr,https://your-app.vercel.app"
# NEXT_PUBLIC_SITE_URL="https://www.your-domain.lr"
# UPLOAD_DIR="/var/data/uploads"
# UPLOAD_PUBLIC_PATH="/uploads"
# COOKIE_SAMESITE="lax"
# COOKIE_SECURE="true"

# Only if browsers call Render API directly (not recommended for Lonestar/Orange):
# COOKIE_SAMESITE="none"
# CORS_ORIGINS="https://www.your-domain.lr"
